# ==============================================================================
# Client Document Chaser — Environment Variables Template
# Copy to .env for local development. Never commit real secrets.
# ==============================================================================

NODE_ENV="development"

# --- Web App (Next.js) ---
PORT="3000"
APP_URL="http://localhost:3000"
APP_PUBLIC_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
API_INTERNAL_URL="http://127.0.0.1:3001"

# --- API Server (NestJS) ---
API_PORT="3001"
API_PREFIX="api/v1"
CORS_ORIGINS="http://localhost:3000"

# --- Client Portal & Uploads ---
PORTAL_TOKEN_TTL_HOURS="168"
PORTAL_MAX_FILE_SIZE_MB="25"

# --- PostgreSQL ---
DATABASE_URL="postgresql://cdc_user:cdc_dev_password@localhost:5432/client_doc_chaser"
DB_HOST="localhost"
DB_PORT="5432"
DB_USERNAME="cdc_user"
DB_PASSWORD="cdc_dev_password"
DB_NAME="client_doc_chaser"
DB_SSL="false"

# --- Redis (BullMQ & Rate Limiting) ---
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"

# --- Authentication & Security ---
JWT_ACCESS_SECRET="replace-with-at-least-32-chars-random-secret-key"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS="30"
COOKIE_DOMAIN=""
COOKIE_SECURE="false"
CSRF_SECRET="replace-with-csrf-secret-key"

# --- Object Storage (Private S3 / PGSTY Silo) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="client-docs-private"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin_dev_password"
S3_FORCE_PATH_STYLE="true"

# --- Malware Scanning (ClamAV Optional Local Daemon) ---
CLAMAV_HOST="localhost"
CLAMAV_PORT="3310"
MALWARE_SCAN_ENABLED="false"

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM=""
RESEND_FROM_EMAIL="Client Document Chaser <notifications@example.com>"
RESEND_WEBHOOK_SECRET=""

# --- Trial & Entitlements ---
TRIAL_DAYS="14"
TRIAL_EXPIRED_READ_ONLY="true"

# --- Gemini AI (Optional platform capability) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
